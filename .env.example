# ─────────────────────────────────────────────────────────────
# All_Santé API — configuration (copier vers .env)
# ─────────────────────────────────────────────────────────────

# Port d'écoute du bus d'interopérabilité
PORT=3010

# Clé API ENTRANTE : exigée des clients (SGCH, DPI, OpenELIS) qui appellent AllSanté
INTEROP_API_KEY=dev-interop-key-change-me

# Systèmes AVAL (cibles de routage)
DPI_INTEROP_URL=http://localhost:3001
OPENELIS_INTEROP_URL=http://localhost:3021

# Clés API SORTANTES : transmises par AllSanté aux systèmes aval
# (par défaut = INTEROP_API_KEY si non renseignées)
DPI_API_KEY=
OPENELIS_API_KEY=

# Timeout des appels aval (ms)
INTEROP_TIMEOUT_MS=8000

# ── Dépôt national (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://USER:MOTDEPASSE@localhost:5432/allsante_global"
  